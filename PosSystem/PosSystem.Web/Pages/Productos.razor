@page "/productos"
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Mantenimiento de Productos</h3>
    <a href="/marcas" class="btn btn-outline-primary">Administrar Marcas</a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <EditForm Model="prodActual" OnValidSubmit="GuardarProducto">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre Producto</label>
                    <InputText @bind-Value="prodActual.NombreProducto" class="form-control" />
                    <ValidationMessage For="@(() => prodActual.NombreProducto)" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Marca</label>
                    <InputSelect @bind-Value="prodActual.IdMarca" class="form-select">
                        <option value="0">-- Seleccione Marca --</option>
                        @if (marcas != null)
                        {
                            @foreach (var m in marcas)
                            {
                                <option value="@m.IdMarca">@m.NombreMarca</option>
                            }
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Descripción</label>
                    <InputText @bind-Value="prodActual.Descripcion" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Precio Costo (Q)</label>
                    <InputNumber @bind-Value="prodActual.PrecioCosto" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Precio Venta (Q)</label>
                    <InputNumber @bind-Value="prodActual.PrecioVenta" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Existencia</label>
                    <InputNumber @bind-Value="prodActual.Existencia" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Imagen del Producto</label>
                    <InputFile OnChange="SubirImagen" class="form-control" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success me-2">Guardar Producto</button>
                <button type="button" class="btn btn-secondary" @onclick="Limpiar">Limpiar</button>
            </div>
        </EditForm>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Imagen</th>
            <th>Producto</th>
            <th>Marca</th>
            <th>P. Costo</th>
            <th>P. Venta</th>
            <th>Existencia</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (productos != null)
        {
            @foreach (var p in productos)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(p.Imagen))
                        {
                            <img src="@p.Imagen" style="width:50px; height:50px; object-fit:cover;" class="rounded border" />
                        }
                        else
                        {
                            <span class="text-muted small">Sin imagen</span>
                        }
                    </td>
                    <td>@p.NombreProducto</td>
                    <td>@p.Marca?.NombreMarca</td>
                    <td>Q @p.PrecioCosto</td>
                    <td>Q @p.PrecioVenta</td>
                    <td><span class="badge @(p.Existencia > 5 ? "bg-success" : "bg-danger")">@p.Existencia</span></td>
                    <td class="text-center">
                        <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(p)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.IdProducto)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Producto>? productos;
    private List<Marca>? marcas;
    private Producto prodActual = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        productos = await Http.GetFromJsonAsync<List<Producto>>("api/productos");
        marcas = await Http.GetFromJsonAsync<List<Marca>>("api/marcas");
    }

    private async Task SubirImagen(InputFileChangeEventArgs e)
    {
        var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(e.File.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5));
        content.Add(fileContent, "file", e.File.Name);

        var res = await Http.PostAsync("api/productos/upload-imagen", content);
        if (res.IsSuccessStatusCode)
        {
            var result = await res.Content.ReadFromJsonAsync<ImagenResult>();
            prodActual.Imagen = result?.Url;
        }
    }

    private async Task GuardarProducto()
    {
        if (prodActual.IdMarca == 0) return;

        if (prodActual.IdProducto == 0)
            await Http.PostAsJsonAsync("api/productos", prodActual);
        else
            await Http.PutAsJsonAsync($"api/productos/{prodActual.IdProducto}", prodActual);

        Limpiar();
        await CargarDatos();
    }

    private void Editar(Producto p)
    {
        prodActual = new Producto
        {
            IdProducto = p.IdProducto,
            NombreProducto = p.NombreProducto,
            IdMarca = p.IdMarca,
            Descripcion = p.Descripcion,
            PrecioCosto = p.PrecioCosto,
            PrecioVenta = p.PrecioVenta,
            Existencia = p.Existencia,
            Imagen = p.Imagen
        };
    }

    private async Task Eliminar(int id)
    {
        await Http.DeleteAsync($"api/productos/{id}");
        await CargarDatos();
    }

    private void Limpiar() => prodActual = new Producto();

    public class ImagenResult { public string Url { get; set; } = string.Empty; }
}