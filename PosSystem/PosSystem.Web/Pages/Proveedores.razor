@page "/proveedores"
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Mantenimiento de Proveedores</h3>
    <a href="/compras" class="btn btn-outline-secondary">Ir a Compras</a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <EditForm Model="provActual" OnValidSubmit="GuardarProveedor">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre Proveedor</label>
                    <InputText @bind-Value="provActual.NombreProveedor" class="form-control" />
                    <ValidationMessage For="@(() => provActual.NombreProveedor)" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">NIT</label>
                    <InputText @bind-Value="provActual.Nit" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <InputText @bind-Value="provActual.Telefono" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Dirección</label>
                    <InputText @bind-Value="provActual.Direccion" class="form-control" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success me-2">Guardar Proveedor</button>
                <button type="button" class="btn btn-secondary" @onclick="Limpiar">Limpiar</button>
            </div>
        </EditForm>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Proveedor</th>
            <th>NIT</th>
            <th>Teléfono</th>
            <th>Dirección</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (proveedores != null)
        {
            @foreach (var p in proveedores)
            {
                <tr>
                    <td>@p.IdProveedor</td>
                    <td>@p.NombreProveedor</td>
                    <td>@p.Nit</td>
                    <td>@p.Telefono</td>
                    <td>@p.Direccion</td>
                    <td class="text-center">
                        <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(p)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.IdProveedor)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Proveedor>? proveedores;
    private Proveedor provActual = new();

    protected override async Task OnInitializedAsync() => await CargarProveedores();

    private async Task CargarProveedores() => proveedores = await Http.GetFromJsonAsync<List<Proveedor>>("api/proveedores");

    private async Task GuardarProveedor()
    {
        if (provActual.IdProveedor == 0)
            await Http.PostAsJsonAsync("api/proveedores", provActual);
        else
            await Http.PutAsJsonAsync($"api/proveedores/{provActual.IdProveedor}", provActual);

        Limpiar();
        await CargarProveedores();
    }

    private void Editar(Proveedor p)
    {
        provActual = new Proveedor
        {
            IdProveedor = p.IdProveedor,
            NombreProveedor = p.NombreProveedor,
            Nit = p.Nit,
            Telefono = p.Telefono,
            Direccion = p.Direccion
        };
    }

    private async Task Eliminar(int id)
    {
        await Http.DeleteAsync($"api/proveedores/{id}");
        await CargarProveedores();
    }

    private void Limpiar() => provActual = new Proveedor();
}