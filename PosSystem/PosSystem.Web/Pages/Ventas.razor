@page "/ventas"
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Módulo de Ventas (Punto de Venta)</h3>
    <a href="/clientes" class="btn btn-outline-primary">Administrar Clientes</a>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}

<div class="card mb-4 shadow-sm border-success">
    <div class="card-header bg-success text-white fw-bold">
        Registrar Nueva Venta
    </div>
    <div class="card-body">
        <EditForm Model="nuevaVenta" OnValidSubmit="RegistrarVenta">
            <DataAnnotationsValidator />
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">No. Factura</label>
                    <InputNumber @bind-Value="nuevaVenta.NoFactura" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Serie</label>
                    <InputText @bind-Value="nuevaVenta.Serie" class="form-control" maxlength="1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Cliente</label>
                    <InputSelect @bind-Value="nuevaVenta.IdCliente" class="form-select">
                        <option value="0">-- Seleccione Cliente --</option>
                        @if (clientes != null)
                        {
                            @foreach (var c in clientes)
                            {
                                <option value="@c.IdCliente">@c.Nombres @c.Apellidos (@c.Nit)</option>
                            }
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Empleado Vendedor</label>
                    <InputSelect @bind-Value="nuevaVenta.IdEmpleado" class="form-select">
                        <option value="0">-- Seleccione Empleado --</option>
                        @if (empleados != null)
                        {
                            @foreach (var e in empleados)
                            {
                                <option value="@e.IdEmpleado">@e.Nombres @e.Apellidos</option>
                            }
                        }
                    </InputSelect>
                </div>
            </div>

            <hr />
            <h5 class="mt-3">Seleccionar Productos</h5>
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-5">
                    <label class="form-label">Producto</label>
                    <select class="form-select" @bind="idProductoSeleccionado" @bind:after="OnProductoCambiado">
                        <option value="0">-- Seleccione Producto --</option>
                        @if (productos != null)
                        {
                            @foreach (var p in productos)
                            {
                                <option value="@p.IdProducto">@p.NombreProducto - Q @p.PrecioVenta (Stock: @p.Existencia)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Cantidad</label>
                    <input type="number" class="form-control" @bind="cantidadTemp" min="1" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Precio Venta</label>
                    <input type="text" class="form-control" value="Q @precioVentaTemp" readonly />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100" @onclick="AgregarDetalle">Agregar Item</button>
                </div>
            </div>

            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!nuevaVenta.Detalles.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted">No hay productos en la orden de venta.</td></tr>
                    }
                    else
                    {
                        @foreach (var d in nuevaVenta.Detalles)
                        {
                            var prod = productos?.FirstOrDefault(p => p.IdProducto == d.IdProducto);
                            <tr>
                                <td>@prod?.NombreProducto</td>
                                <td>@d.Cantidad</td>
                                <td>Q @d.PrecioUnitario</td>
                                <td class="fw-bold">Q @(d.Cantidad * d.PrecioUnitario)</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => QuitarDetalle(d)">Quitar</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="table-active fs-5">
                        <td colspan="3" class="text-end fw-bold">TOTAL DE LA VENTA:</td>
                        <td colspan="2" class="fw-bold text-success">Q @TotalVenta</td>
                    </tr>
                </tfoot>
            </table>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-success btn-lg fw-bold" disabled="@(!nuevaVenta.Detalles.Any())">
                    Procesar Factura y Realizar Venta
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private VentaCreateDTO nuevaVenta = new();
    private List<Cliente>? clientes;
    private List<Empleado>? empleados;
    private List<Producto>? productos;

    private int idProductoSeleccionado = 0;
    private int cantidadTemp = 1;
    private decimal precioVentaTemp = 0;

    private string? mensajeError;
    private string? mensajeExito;

    private decimal TotalVenta => nuevaVenta.Detalles.Sum(d => d.Cantidad * d.PrecioUnitario);

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        clientes = await Http.GetFromJsonAsync<List<Cliente>>("api/clientes");
        empleados = await Http.GetFromJsonAsync<List<Empleado>>("api/empleados");
        productos = await Http.GetFromJsonAsync<List<Producto>>("api/productos");
    }

    private void OnProductoCambiado()
    {
        var prod = productos?.FirstOrDefault(p => p.IdProducto == idProductoSeleccionado);
        if (prod != null)
        {
            precioVentaTemp = prod.PrecioVenta;
        }
    }

    private void AgregarDetalle()
    {
        mensajeError = null;
        var prod = productos?.FirstOrDefault(p => p.IdProducto == idProductoSeleccionado);

        if (prod == null || cantidadTemp <= 0)
        {
            mensajeError = "Seleccione un producto válido y una cantidad mayor a cero.";
            return;
        }

        if (cantidadTemp > prod.Existencia)
        {
            mensajeError = $"No se puede realizar la venta. Existencia insuficiente para '{prod.NombreProducto}'. Disponible: {prod.Existencia}, Solicitada: {cantidadTemp}.";
            return;
        }

        nuevaVenta.Detalles.Add(new VentaDetalleDTO
        {
            IdProducto = idProductoSeleccionado,
            Cantidad = cantidadTemp,
            PrecioUnitario = prod.PrecioVenta
        });

        idProductoSeleccionado = 0;
        cantidadTemp = 1;
        precioVentaTemp = 0;
    }

    private void QuitarDetalle(VentaDetalleDTO d) => nuevaVenta.Detalles.Remove(d);

    private async Task RegistrarVenta()
    {
        if (nuevaVenta.IdCliente == 0 || nuevaVenta.IdEmpleado == 0)
        {
            mensajeError = "Debe seleccionar tanto el cliente como el empleado.";
            return;
        }

        var res = await Http.PostAsJsonAsync("api/ventas", nuevaVenta);
        if (res.IsSuccessStatusCode)
        {
            mensajeExito = "¡Venta procesada con éxito! El stock ha sido descontado automáticamente.";
            nuevaVenta = new VentaCreateDTO();
            await CargarDatos();
        }
        else
        {
            mensajeError = await res.Content.ReadAsStringAsync();
        }
    }
}