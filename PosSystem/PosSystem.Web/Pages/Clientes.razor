@page "/clientes"
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Mantenimiento de Clientes</h3>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <EditForm Model="clienteActual" OnValidSubmit="GuardarCliente">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombres</label>
                    <InputText @bind-Value="clienteActual.Nombres" class="form-control" />
                    <ValidationMessage For="@(() => clienteActual.Nombres)" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Apellidos</label>
                    <InputText @bind-Value="clienteActual.Apellidos" class="form-control" />
                    <ValidationMessage For="@(() => clienteActual.Apellidos)" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">NIT</label>
                    <InputText @bind-Value="clienteActual.Nit" class="form-control" placeholder="CF o Número" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <InputText @bind-Value="clienteActual.Telefono" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Correo Electrónico</label>
                    <InputText @bind-Value="clienteActual.CorreoElectronico" class="form-control" />
                    <ValidationMessage For="@(() => clienteActual.CorreoElectronico)" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Género</label>
                    <InputSelect @bind-Value="clienteActual.Genero" class="form-select">
                        <option value="false">Femenino</option>
                        <option value="true">Masculino</option>
                    </InputSelect>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success me-2">Guardar Cliente</button>
                <button type="button" class="btn btn-secondary" @onclick="Limpiar">Limpiar</button>
            </div>
        </EditForm>
    </div>
</div>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Buscar cliente por nombre o NIT..." @bind="filtro" @bind:event="oninput" />
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre Completo</th>
            <th>NIT</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (clientesFiltrados != null)
        {
            @foreach (var c in clientesFiltrados)
            {
                <tr>
                    <td>@c.IdCliente</td>
                    <td>@c.Nombres @c.Apellidos</td>
                    <td>@c.Nit</td>
                    <td>@c.Telefono</td>
                    <td>@c.CorreoElectronico</td>
                    <td class="text-center">
                        <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(c)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(c.IdCliente)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Cliente>? clientes;
    private Cliente clienteActual = new();
    private string filtro = string.Empty;

    private IEnumerable<Cliente>? clientesFiltrados =>
        string.IsNullOrWhiteSpace(filtro)
            ? clientes
            : clientes?.Where(c => c.Nombres.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                                  c.Apellidos.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                                  (c.Nit != null && c.Nit.Contains(filtro, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync() => await CargarClientes();

    private async Task CargarClientes() => clientes = await Http.GetFromJsonAsync<List<Cliente>>("api/clientes");

    private async Task GuardarCliente()
    {
        if (clienteActual.IdCliente == 0)
            await Http.PostAsJsonAsync("api/clientes", clienteActual);
        else
            await Http.PutAsJsonAsync($"api/clientes/{clienteActual.IdCliente}", clienteActual);

        Limpiar();
        await CargarClientes();
    }

    private void Editar(Cliente c)
    {
        clienteActual = new Cliente
        {
            IdCliente = c.IdCliente,
            Nombres = c.Nombres,
            Apellidos = c.Apellidos,
            Nit = c.Nit,
            Telefono = c.Telefono,
            CorreoElectronico = c.CorreoElectronico,
            Genero = c.Genero
        };
    }

    private async Task Eliminar(int id)
    {
        await Http.DeleteAsync($"api/clientes/{id}");
        await CargarClientes();
    }

    private void Limpiar() => clienteActual = new Cliente();
}