@page "/puestos"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Mantenimiento de Puestos</h3>
    <a href="/empleados" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Regresar a Empleados
    </a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5>@(puestoActual.IdPuesto == 0 ? "Crear Nuevo Puesto" : "Modificar Puesto")</h5>
        <EditForm Model="puestoActual" OnValidSubmit="GuardarPuesto">
            <DataAnnotationsValidator />
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <InputText @bind-Value="puestoActual.NombrePuesto" class="form-control" placeholder="Nombre del puesto" />
                    <ValidationMessage For="@(() => puestoActual.NombrePuesto)" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success me-2">Guardar</button>
                    @if (puestoActual.IdPuesto != 0)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="LimpiarFormulario">Cancelar</button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Buscar puestos..." @bind="filtro" @bind:event="oninput" />
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre del Puesto</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (puestosFiltrados == null)
        {
            <tr><td colspan="3" class="text-center">Cargando datos...</td></tr>
        }
        else if (!puestosFiltrados.Any())
        {
            <tr><td colspan="3" class="text-center text-muted">No se encontraron registros.</td></tr>
        }
        else
        {
            @foreach (var p in puestosFiltrados)
            {
                <tr>
                    <td>@p.IdPuesto</td>
                    <td>@p.NombrePuesto</td>
                    <td class="text-center">
                        <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(p)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.IdPuesto)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Puesto>? listaPuestos;
    private Puesto puestoActual = new();
    private string filtro = string.Empty;

    private IEnumerable<Puesto>? puestosFiltrados =>
        string.IsNullOrWhiteSpace(filtro)
            ? listaPuestos
            : listaPuestos?.Where(p => p.NombrePuesto.Contains(filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
    }

    private async Task CargarPuestos()
    {
        listaPuestos = await Http.GetFromJsonAsync<List<Puesto>>("api/puestos");
    }

    private async Task GuardarPuesto()
    {
        if (puestoActual.IdPuesto == 0)
            await Http.PostAsJsonAsync("api/puestos", puestoActual);
        else
            await Http.PutAsJsonAsync($"api/puestos/{puestoActual.IdPuesto}", puestoActual);

        LimpiarFormulario();
        await CargarPuestos();
    }

    private void Editar(Puesto p)
    {
        puestoActual = new Puesto { IdPuesto = p.IdPuesto, NombrePuesto = p.NombrePuesto };
    }

    private async Task Eliminar(short id)
    {
        await Http.DeleteAsync($"api/puestos/{id}");
        await CargarPuestos();
    }

    private void LimpiarFormulario()
    {
        puestoActual = new Puesto();
    }
}